# Copy to .env; Compose reads it automatically.
# Local HTTP defaults. Enable secure cookies before deploying behind HTTPS.
PANDA_BIND=127.0.0.1
PANDA_PORT=8080
PANDA_BASE_URL=http://localhost:8080
PANDA_COOKIE_SECURE=false
# Leave blank to use the browser language, falling back to English.
PANDA_LANG=
TZ=UTC
# Recorded in the binary version and backup manifests.
PANDA_VERSION=dev
